<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kern-Projekt = generische (Template-)Variante "WebAppDashboard".
    Alle anderen Varianten importieren diese Quellen über brand.props/brand.targets.
  -->
  <PropertyGroup>
    <BrandId>WebAppDashboard</BrandId>
  </PropertyGroup>

  <Import Project="WebAppDashboard.brand.props" />

  <PropertyGroup>
    <ApplicationIcon>$(MSBuildThisFileDirectory)app.ico</ApplicationIcon>
  </PropertyGroup>

  <Import Project="WebAppDashboard.brand.targets" />

</Project>